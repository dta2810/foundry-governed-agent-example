{
  "datasets": [
    {
      "name": "ds_tool_calls",
      "displayName": "Gateway MCP tool calls (system.ai_gateway.usage)",
      "queryLines": [
        "SELECT\n",
        "  u.event_time,\n",
        "  u.requester,\n",
        "  CASE WHEN u.requester = :sp_app_id THEN concat(:sp_display_name, ' (SP)') ELSE u.requester END AS identity,\n",
        "  CASE WHEN u.requester_type = 'SERVICE_PRINCIPAL' THEN 'Service principal' ELSE 'End user (OBO)' END AS identity_type,\n",
        "  u.service_name AS mcp_service,\n",
        "  concat(replace(u.service_name, 'system.ai.', ''), ' / ', coalesce(u.mcp_metadata.tool_name, 'unknown')) AS tool,\n",
        "  u.status_code,\n",
        "  CASE WHEN u.status_code BETWEEN 200 AND 299 THEN 'Success' WHEN u.status_code IN (401, 403) THEN 'Denied' ELSE 'Error' END AS outcome,\n",
        "  CASE WHEN u.status_code BETWEEN 200 AND 299 THEN 1 ELSE 0 END AS is_success,\n",
        "  CASE WHEN u.status_code IN (401, 403) THEN 1 ELSE 0 END AS is_denied,\n",
        "  CASE WHEN CAST(u.event_time AS DATE) = current_date() THEN 1 ELSE 0 END AS is_today,\n",
        "  u.latency_ms\n",
        "FROM system.ai_gateway.usage u\n",
        "WHERE u.workspace_id = :workspace_id\n",
        "  AND u.requester IN (:user_email, :sp_app_id)  -- scoped identities only\n",
        "  AND u.service_type = 'MCP_SERVICE'\n",
        "  AND u.service_name IN ('system.ai.dbsql', 'system.ai.genie_one_mcp')\n",
        "  AND u.mcp_metadata.json_rpc_method = 'tools/call'\n",
        "  AND u.event_time >= :date_range.min AND u.event_time < date_add(:date_range.max, 1)\n"
      ],
      "parameters": [
        {
          "displayName": "date_range",
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now-7d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        },
        {
          "displayName": "workspace_id (deploy-time: this workspace)",
          "keyword": "workspace_id",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "<workspace-id>"
                }
              ]
            }
          }
        },
        {
          "displayName": "sp_app_id",
          "keyword": "sp_app_id",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "<regional-sp-app-id>"
                }
              ]
            }
          }
        },
        {
          "displayName": "sp_display_name",
          "keyword": "sp_display_name",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "<regional-sp-name>"
                }
              ]
            }
          }
        },
        {
          "displayName": "user_email",
          "keyword": "user_email",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "<user-email>"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_statements",
      "displayName": "SQL statements by agent tools (system.query.history)",
      "queryLines": [
        "SELECT\n",
        "  q.start_time,\n",
        "  q.statement_id,\n",
        "  q.executed_by,\n",
        "  CASE WHEN q.executed_by = :sp_app_id THEN concat(:sp_display_name, ' (SP)') ELSE q.executed_by END AS identity,\n",
        "  q.executed_as,\n",
        "  CASE WHEN q.client_application = 'Databricks SQL MCP' THEN 'dbsql / execute_sql' ELSE coalesce(q.client_application, 'unknown') END AS tool,\n",
        "  q.compute.warehouse_id AS warehouse_id,\n",
        "  coalesce(w.warehouse_name, q.compute.warehouse_id, 'unknown') AS warehouse,\n",
        "  CASE WHEN q.statement_text = '<REDACTED>' THEN '(text redacted in query history)' ELSE left(regexp_replace(q.statement_text, '\\\\s+', ' '), 160) END AS statement_preview,\n",
        "  coalesce(q.read_rows, 0) AS read_rows,\n",
        "  round(q.total_duration_ms / 1000.0, 2) AS duration_s,\n",
        "  q.execution_status,\n",
        "  coalesce(regexp_extract(q.error_message, '^\\\\[([A-Z_.]+)\\\\]', 1), '') AS error_class,\n",
        "  coalesce(regexp_extract(q.error_message, 'on [A-Za-z]+ \\'([^\\']+)\\'', 1), '') AS denied_object,\n",
        "  coalesce(left(regexp_replace(q.error_message, '\\\\s+', ' '), 220), '') AS error_summary,\n",
        "  CASE WHEN q.error_message LIKE '%INSUFFICIENT_PERMISSIONS%' OR q.error_message LIKE '%PERMISSION_DENIED%' THEN 1 ELSE 0 END AS is_denied,\n",
        "  CASE WHEN q.execution_status = 'FAILED' THEN 1 ELSE 0 END AS is_failed\n",
        "FROM system.query.history q\n",
        "LEFT JOIN (\n",
        "  SELECT warehouse_id, warehouse_name\n",
        "  FROM system.compute.warehouses\n",
        "  WHERE workspace_id = :workspace_id\n",
        "  QUALIFY row_number() OVER (PARTITION BY warehouse_id ORDER BY change_time DESC) = 1\n",
        ") w ON w.warehouse_id = q.compute.warehouse_id\n",
        "WHERE q.workspace_id = :workspace_id\n",
        "  AND q.executed_by IN (:user_email, :sp_app_id)  -- scoped identities only\n",
        "  AND q.start_time >= :date_range.min AND q.start_time < date_add(:date_range.max, 1)\n",
        "  AND (\n",
        "    q.client_application = 'Databricks SQL MCP'\n",
        "    OR q.statement_text ILIKE concat('%', :pricing_schema, '%')\n",
        "    OR q.error_message ILIKE concat('%', :pricing_schema, '%')\n",
        "  )\n",
        "ORDER BY q.start_time DESC\n"
      ],
      "parameters": [
        {
          "displayName": "date_range",
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now-7d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        },
        {
          "displayName": "workspace_id (deploy-time: this workspace)",
          "keyword": "workspace_id",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "<workspace-id>"
                }
              ]
            }
          }
        },
        {
          "displayName": "sp_app_id",
          "keyword": "sp_app_id",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "<regional-sp-app-id>"
                }
              ]
            }
          }
        },
        {
          "displayName": "sp_display_name",
          "keyword": "sp_display_name",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "<regional-sp-name>"
                }
              ]
            }
          }
        },
        {
          "displayName": "pricing_schema",
          "keyword": "pricing_schema",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "<catalog>.<schema>"
                }
              ]
            }
          }
        },
        {
          "displayName": "user_email",
          "keyword": "user_email",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "<user-email>"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ds_audit",
      "displayName": "MCP audit trail (system.access.audit)",
      "queryLines": [
        "SELECT\n",
        "  a.event_time,\n",
        "  a.user_identity.email AS principal,\n",
        "  CASE WHEN a.user_identity.email = :sp_app_id THEN concat(:sp_display_name, ' (SP)') ELSE a.user_identity.email END AS identity,\n",
        "  a.request_params.fully_qualified_name AS mcp_service,\n",
        "  concat(replace(a.request_params.fully_qualified_name, 'system.ai.', ''), ' / ', coalesce(a.request_params.tool_name, 'unknown')) AS tool,\n",
        "  a.response.status_code AS status_code,\n",
        "  CASE WHEN a.response.status_code BETWEEN 200 AND 299 THEN 'Success' WHEN a.response.status_code IN (401, 403) THEN 'Denied' ELSE 'Error' END AS outcome,\n",
        "  coalesce(left(a.response.error_message, 200), '') AS error_message,\n",
        "  a.source_ip_address\n",
        "FROM system.access.audit a\n",
        "WHERE a.workspace_id = :workspace_id\n",
        "  AND a.user_identity.email IN (:user_email, :sp_app_id)  -- scoped identities only\n",
        "  AND a.service_name = 'mcpService'\n",
        "  AND a.action_name = 'mcpCall'\n",
        "  AND a.request_params.json_rpc_method = 'tools/call'\n",
        "  AND a.request_params.fully_qualified_name IN ('system.ai.dbsql', 'system.ai.genie_one_mcp')\n",
        "  AND a.event_date >= :date_range.min AND a.event_date <= :date_range.max\n",
        "  AND a.event_time >= :date_range.min AND a.event_time < date_add(:date_range.max, 1)\n",
        "ORDER BY a.event_time DESC\n"
      ],
      "parameters": [
        {
          "displayName": "date_range",
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now-7d/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          }
        },
        {
          "displayName": "workspace_id (deploy-time: this workspace)",
          "keyword": "workspace_id",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "<workspace-id>"
                }
              ]
            }
          }
        },
        {
          "displayName": "sp_app_id",
          "keyword": "sp_app_id",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "<regional-sp-app-id>"
                }
              ]
            }
          }
        },
        {
          "displayName": "sp_display_name",
          "keyword": "sp_display_name",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "<regional-sp-name>"
                }
              ]
            }
          }
        },
        {
          "displayName": "user_email",
          "keyword": "user_email",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "<user-email>"
                }
              ]
            }
          }
        }
      ]
    }
