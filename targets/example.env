# Copy to targets/<target>.env (gitignored) and fill in. Every script reads it when BEV_TARGET=<target>.
# Ids the scripts create (warehouse, Entra apps, SharePoint files, dashboard) go to targets/<target>.resolved.env.

# Environment suffix (REQUIRED, 1-12 chars a-z0-9). Groups, Gateway policies and agent names are account- or
# metastore-wide: pick a suffix nobody else on the account uses (for example your initials + a number)
BEV_ENV=<unique-suffix>

# Databricks workspace (Azure Databricks, Unity Catalog, serverless)
DATABRICKS_CONFIG_PROFILE=<workspace-cli-profile>
BEV_ACCOUNT_PROFILE=<account-cli-profile>            # account admin, for setup/identities.py
BEV_HOST=https://adb-<workspace-id>.<n>.azuredatabricks.net   # the adb- host, not a vanity URL
BEV_WORKSPACE_ID=<workspace-id>
BEV_CATALOG=<existing-catalog>                       # you need CREATE SCHEMA on it
BEV_USER=<user-email>                      # Gateway policies are scoped to this identity
BEV_TRACE_TABLE=<catalog>.<schema>.<table>           # metastore unified Gateway trace table (DEPLOYMENT.md step 11)

# Microsoft Entra (tenant of the workspace and of Foundry)
BEV_TENANT_ID=<entra-tenant-id>

# SharePoint / OneDrive folder of the example user that holds the SharePoint documents
BEV_M365_FOLDER=acme-beverages-docs

# Resource tags (JSON). Account tag policies may restrict keys or values.
BEV_TAGS={"bev_project": "governed_agent_env1", "owner": "<owner>"}

# Optional overrides (defaults shown)
# BEV_SCHEMA=bev_pricing_<env>
# BEV_TRACE_SCHEMA=bev_traces_<env>
# BEV_WAREHOUSE_NAME=bev-pricing-wh-<env>
# BEV_SECRET_SCOPE=bev-pricing-<env>
# BEV_GROUP_ADMIN=bev_pricing_admin_<env>   BEV_GROUP_EAST=bev_pricing_east_<env>   BEV_GROUP_WEST=bev_pricing_west_<env>
# BEV_REGIONAL_SP_NAME=bev-pricing-regional-sp-<env>   BEV_PASSTHROUGH_APP_NAME=bev-foundry-passthrough-<env>
